---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getQuestion } from '../lib/questions';

const question = getQuestion();

const env = (Astro.locals as any).runtime?.env;
let initialAnswers: { text: string }[] = [];
let total = 0;

if (env?.DB) {
  const result = await env.DB.prepare(
    'SELECT text FROM answers WHERE question_index = ? ORDER BY created_at DESC LIMIT 100'
  )
    .bind(question.index)
    .all();
  initialAnswers = result.results as { text: string }[];
  total = initialAnswers.length;
}
---

<Layout
  title="human4ai"
  description="每天一个只有人类才能回答的问题。"
>
  <!-- Nav -->
  <nav class="fixed top-0 w-full z-10 border-b border-border bg-bg/90 backdrop-blur-sm">
    <div class="max-w-2xl mx-auto px-6 py-4 flex items-center justify-between">
      <span class="font-mono text-xs text-amber-400">human4ai.ai</span>
      <div class="flex gap-6">
        <a href="/articles" class="text-xs text-subtle hover:text-text transition-colors">文章</a>
        <a href="/about" class="text-xs text-subtle hover:text-text transition-colors">关于</a>
      </div>
    </div>
  </nav>

  <main class="max-w-2xl mx-auto px-6 pt-32 pb-24">

    <!-- Today's question -->
    <section class="mb-16">
      <p class="font-mono text-xs text-subtle tracking-widest uppercase mb-6">
        今天的问题
      </p>
      <h1
        id="question"
        class="text-2xl md:text-3xl font-bold text-white leading-snug"
        data-index={question.index}
      >
        {question.text}
      </h1>
    </section>

    <!-- Submit form -->
    <section class="mb-20">
      <form id="answer-form" class="space-y-3">
        <div class="relative">
          <textarea
            id="answer-input"
            name="text"
            placeholder="一句话就够"
            maxlength="280"
            rows="2"
            class="w-full bg-surface border border-border text-text placeholder-muted text-sm
                   px-4 py-3 rounded-sm resize-none focus:outline-none focus:border-amber-400/50
                   transition-colors font-sans leading-relaxed"
          ></textarea>
          <span
            id="char-count"
            class="absolute bottom-3 right-3 font-mono text-xs text-muted"
          >0 / 280</span>
        </div>
        <button
          type="submit"
          class="inline-flex items-center gap-2 text-sm text-amber-400 border border-amber-400/30
                 px-4 py-2 rounded-sm hover:bg-amber-400/10 transition-colors"
        >
          <span>提交</span>
          <span>→</span>
        </button>
        <p id="form-msg" class="text-xs text-subtle hidden"></p>
      </form>
    </section>

    <!-- Divider with answer count -->
    <div class="flex items-center gap-4 mb-10">
      <div class="flex-1 border-t border-border"></div>
      <p id="answer-count" class="font-mono text-xs text-muted shrink-0">
        {total === 0 ? '还没有人回答' : `${total} 个人回答了`}
      </p>
      <div class="flex-1 border-t border-border"></div>
    </div>

    <!-- Answers feed -->
    <ul id="answers-list" class="space-y-4">
      {initialAnswers.map((a) => (
        <li class="text-subtle text-sm leading-relaxed pl-4 border-l border-border">
          {a.text}
        </li>
      ))}
      {initialAnswers.length === 0 && (
        <li id="empty-hint" class="text-muted text-sm italic">
          第一个回答，留下一点人类的痕迹。
        </li>
      )}
    </ul>

  </main>
</Layout>

<script>
  const form = document.getElementById('answer-form') as HTMLFormElement;
  const input = document.getElementById('answer-input') as HTMLTextAreaElement;
  const countEl = document.getElementById('char-count')!;
  const msgEl = document.getElementById('form-msg')!;
  const listEl = document.getElementById('answers-list')!;
  const countBadge = document.getElementById('answer-count')!;
  let total = parseInt(countBadge.dataset.total ?? '0', 10) || 0;

  // Char counter
  input.addEventListener('input', () => {
    countEl.textContent = `${input.value.length} / 280`;
  });

  function prependAnswer(text: string) {
    const empty = document.getElementById('empty-hint');
    if (empty) empty.remove();

    const li = document.createElement('li');
    li.className = 'text-subtle text-sm leading-relaxed pl-4 border-l border-border opacity-0 transition-opacity duration-500';
    li.textContent = text;
    listEl.prepend(li);
    requestAnimationFrame(() => { li.style.opacity = '1'; });

    total++;
    countBadge.textContent = `${total} 个人回答了`;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;

    const btn = form.querySelector('button')!;
    btn.disabled = true;
    msgEl.classList.add('hidden');

    try {
      const res = await fetch('/api/answer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text }),
      });

      if (res.ok) {
        prependAnswer(text);
        input.value = '';
        countEl.textContent = '0 / 280';
        msgEl.textContent = '已提交。';
        msgEl.classList.remove('hidden', 'text-red-400');
        msgEl.classList.add('text-subtle');
        setTimeout(() => msgEl.classList.add('hidden'), 3000);
      } else {
        throw new Error();
      }
    } catch {
      msgEl.textContent = '提交失败，请再试一次。';
      msgEl.classList.remove('hidden', 'text-subtle');
      msgEl.classList.add('text-red-400');
    } finally {
      btn.disabled = false;
    }
  });

  // Poll for new answers every 45 seconds
  let latestCount = parseInt(
    document.getElementById('answer-count')?.textContent?.match(/\d+/)?.[0] ?? '0',
    10
  );

  async function pollAnswers() {
    try {
      const res = await fetch('/api/today');
      if (!res.ok) return;
      const data: { answers: { text: string }[]; total: number } = await res.json();
      if (data.total > latestCount) {
        // Prepend only the new ones
        const newAnswers = data.answers.slice(0, data.total - latestCount);
        newAnswers.forEach(a => prependAnswer(a.text));
        latestCount = data.total;
      }
    } catch {}
  }

  setInterval(pollAnswers, 45_000);
</script>
